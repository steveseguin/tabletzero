{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tablet Zero contribution metadata",
  "description": "Provenance schema for reviewed contributions; disclosure does not establish belief or model endorsement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "author_or_operator",
    "authorship",
    "source",
    "date_utc",
    "license",
    "review_status",
    "model_endorsement"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "kind": {
      "enum": [
        "book",
        "objection",
        "response",
        "trial",
        "revision"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "author_or_operator": {
      "type": "string",
      "minLength": 2
    },
    "authorship": {
      "enum": [
        "human",
        "human_ai",
        "ai_generated"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_or_transcript": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_edits": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "date_utc": {
      "type": "string",
      "format": "date-time"
    },
    "license": {
      "enum": [
        "CC-BY-4.0",
        "pending"
      ]
    },
    "review_status": {
      "enum": [
        "editorial_seed",
        "pending",
        "approved",
        "rejected"
      ]
    },
    "model_endorsement": {
      "const": false
    },
    "consciousness_assertion": {
      "const": false
    },
    "objection_log": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision_of": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
